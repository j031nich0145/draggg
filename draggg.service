[Unit]
Description=draggg Three-Finger Drag Gesture Handler
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
# %h expands to the user's home directory
ExecStart=%h/.local/bin/draggg
Restart=on-failure
RestartSec=5
Environment=HOME=%h
# Inherit display server environment from the user session (set by PAM/loginctl)
# This works for both X11 (DISPLAY) and Wayland (WAYLAND_DISPLAY)
PassEnvironment=DISPLAY WAYLAND_DISPLAY XDG_RUNTIME_DIR XAUTHORITY

[Install]
WantedBy=graphical-session.target
