[Unit]
Description=draggg - Linux Three-Finger Drag Gesture Handler
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /path/to/Linux_Three_Fingers/draggg.py --config %h/.config/three-finger-drag/config.json --tray
Restart=on-failure
RestartSec=5
Environment=DISPLAY=:0

[Install]
WantedBy=default.target

